{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seh://schemas/authoring_record.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "target_kind": {
      "type": "string"
    },
    "target_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "enum": [
        "text_only",
        "behavioral",
        "high_risk"
      ]
    },
    "exploration": {
      "type": "object"
    },
    "spec": {
      "type": "object"
    },
    "plan_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "CLASSIFIED",
        "EXPLORED",
        "PLANNED",
        "AWAITING_APPROVAL",
        "APPROVED",
        "BASELINED",
        "WRITTEN",
        "VERIFYING",
        "REPAIRING",
        "COMPARED",
        "AWAITING_EVAL",
        "PROMOTED",
        "REJECTED",
        "BLOCKED_NO_EVAL",
        "NEEDS_HUMAN",
        "ROLLED_BACK"
      ]
    }
  },
  "required": [
    "id",
    "target_kind",
    "target_paths",
    "risk",
    "exploration",
    "spec",
    "state"
  ],
  "additionalProperties": false
}
